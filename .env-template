# =============================================
# DESKTO Backend Environment Configuration
# Copy this file to .env and update values
# =============================================

# Node.js Configuration
NODE_ENV=production
PORT=3001

# Database Configuration
DB_HOST=deskto-website-postgres.cto4qa26irya.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=deskto_db
DB_USER=deskto_admin
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_HERE_minimum_32_characters

# Frontend URL
FRONTEND_URL=http://13.234.99.45

# API Rate Limiting (optional)
API_RATE_LIMIT=1000
API_RATE_WINDOW=900000

# AWS / Homepage CMS image upload (Phase 6)
# EC2 instance role credentials are picked up automatically — no access keys
# required in env. The bucket must have Block Public Access enabled and be
# fronted by a CloudFront distribution using OAC.
AWS_REGION=ap-south-1
PRODUCT_IMAGE_BUCKET=deskto-product-images-prod
PRODUCT_IMAGE_CDN_URL=https://d1woimfbsae6v4.cloudfront.net
# Backwards-compatible aliases accepted by the CMS S3 routes:
# S3_BUCKET_NAME=deskto-product-images-prod
# IMAGE_CLOUDFRONT_BASE_URL=https://d1woimfbsae6v4.cloudfront.net